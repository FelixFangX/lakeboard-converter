{
  "name": "lakeboard-converter",
  "version": "0.4.1",
  "mcpName": "io.github.FelixFangX/lakeboard-converter",
  "description": "CLI & Web tool to convert Yuque Lakeboard (.lakeboard) and XMind (.xmind) files into Markdown",
  "type": "module",
  "bin": {
    "lakeboard-converter": "./dist/cli.js",
    "mindmap-converter": "./dist/cli.js",
    "lakeboard-converter-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:web": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:web": "vite build",
    "deploy:web": "npm run build:web && npx wrangler@3 deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "convert": "tsx src/cli.ts convert",
    "start": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "lakeboard",
    "markdown",
    "xmind",
    "converter",
    "mindmap",
    "typescript",
    "mcp",
    "mcp-server",
    "yuque",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "jszip": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.8",
    "vitest": "^3.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixFangX/lakeboard-converter.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://convert.ledring.dev",
  "bugs": {
    "url": "https://github.com/FelixFangX/lakeboard-converter/issues"
  },
  "author": "Felix Fang"
}
