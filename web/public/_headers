# Opt out of Cloudflare edge HTML rewriting (e.g. the zone-wide Web Analytics beacon),
# so the page makes no third-party requests. This rule also covers index.html served
# as the single-page-application fallback for unknown paths.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Vite emits content-hashed file names under /assets/, so they can be cached forever.
# No `no-transform` here: it would stop Cloudflare from compressing JS and CSS, and
# the beacon is only ever injected into HTML.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts keep stable (unhashed) file names, so cache them for 30 days
# without `immutable`; rename the file if a font subset ever changes.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000
