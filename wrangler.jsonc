{
  "name": "lakeboard-convert",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "convert.ledring.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application"
  },
  // Preview Worker: workers.dev only. `routes` is not inherited by environments,
  // so the production custom domain is never attached here.
  // Deploy: npx wrangler@3 deploy --env preview
  "env": {
    "preview": {
      "name": "lakeboard-convert-preview",
      "workers_dev": true,
      "routes": []
    }
  }
}
