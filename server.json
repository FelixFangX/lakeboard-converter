{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.FelixFangX/lakeboard-converter",
  "description": "Read OPML, FreeMind, Freeplane, Markdown, Lakeboard, XMind, and MindManager as Markdown; build XMind from Markdown.",
  "repository": {
    "url": "https://github.com/FelixFangX/lakeboard-converter",
    "source": "github"
  },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lakeboard-converter",
      "version": "0.5.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "registryBaseUrl": "https://registry.npmjs.org"
    }
  ],
  "title": "Lakeboard Converter",
  "websiteUrl": "https://convert.ledring.dev"
}
